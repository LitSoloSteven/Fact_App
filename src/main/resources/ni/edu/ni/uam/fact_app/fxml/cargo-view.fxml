<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="577.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.uam.fact_app.controller.CargoController">
    <children>
        <GridPane alignment="CENTER" prefHeight="127.0" prefWidth="600.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="294.0" minWidth="0.0" prefWidth="192.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="600.0" minWidth="10.0" prefWidth="408.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Código">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </Label>
                <TextField fx:id="txtId" GridPane.columnIndex="1">
                    <GridPane.margin><Insets right="20.0" /></GridPane.margin>
                </TextField>

                <Label text="Nombre" GridPane.rowIndex="1">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </Label>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <GridPane.margin><Insets right="20.0" /></GridPane.margin>
                </TextField>

                <Label text="Descripción" GridPane.rowIndex="2">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                </Label>
                <TextField fx:id="txtDescripcion" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <GridPane.margin><Insets right="20.0" /></GridPane.margin>
                </TextField>
            </children>
        </GridPane>

        <Button fx:id="btnAgregar" mnemonicParsing="false" onAction="#agregar" prefHeight="41.0" prefWidth="80.0" text="Agregar">
            <VBox.margin><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></VBox.margin>
        </Button>

        <Separator prefWidth="200.0">
            <VBox.margin><Insets bottom="10.0" left="30.0" right="30.0" top="10.0" /></VBox.margin>
        </Separator>

        <!-- BÚSQUEDA -->
        <ToolBar prefHeight="40.0" prefWidth="200.0">
            <items>
                <TextField fx:id="txtBuscar" onAction="#buscar" prefHeight="25.0" prefWidth="430.0" promptText="Busqueda" />
                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscar" prefHeight="25.0" prefWidth="111.0" text="Buscar" />
            </items>
        </ToolBar>

        <TableView fx:id="tblCargos" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="Id" />
                <TableColumn fx:id="colNombre" prefWidth="117.0" text="Nombre" />
                <TableColumn fx:id="colDescripcion" prefWidth="365.0" text="Descripción" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <ToolBar prefHeight="40.0" prefWidth="200.0">
            <items>
                <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editar" prefHeight="25.0" prefWidth="272.0" text="Editar" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" prefHeight="25.0" prefWidth="272.0" text="Eliminar" />
            </items>
        </ToolBar>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
