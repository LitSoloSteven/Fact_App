<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="450.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.ni.uam.fact_app.controller.CategoriaController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15"/></padding>

            <Label text="Nombre de Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Activa:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <CheckBox fx:id="chkActiva" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        </GridPane>
    </top>

    <center>
        <TableView fx:id="tblCategorias" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="350"/>
                <TableColumn fx:id="colActiva" text="Estado" prefWidth="100"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="15"/></padding>
            <Button fx:id="btnGuardar" text="Guardar Registro" onAction="#guardar" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnCerrar" text="Cerrar Ventana" onAction="#cerrar"/>
        </HBox>
    </bottom>
</BorderPane>