<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.uam.fact_app.controller.CategoriaController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <top>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15" /></padding>

            <Label text="Nombre de Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Activa:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <CheckBox fx:id="chkActiva" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <columnConstraints>
                <ColumnConstraints />
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Filtrar:" />
                <TextField fx:id="txtBusqueda" onAction="#buscar" prefWidth="250.0" promptText="Buscar por ID o nombre" />
                <ComboBox fx:id="cmbFiltroEstado" prefWidth="110.0" />
                <Button fx:id="btnBuscar" onAction="#buscar" text="Buscar" />
            </HBox>

            <TableView fx:id="tblCategorias" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                    <TableColumn fx:id="colActiva" prefWidth="100.0" text="Activa" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="15" /></padding>
            <Button fx:id="btnGuardar" onAction="#guardar" style="-fx-font-weight: bold;" text="Guardar Registro" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
            <Button fx:id="btnCerrar" onAction="#cerrar" text="Cerrar Ventana" />
        </HBox>
    </bottom>
</BorderPane>
