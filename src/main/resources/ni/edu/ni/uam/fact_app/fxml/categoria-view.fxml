<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="450.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.uam.fact_app.controller.CategoriaController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <top>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15" /></padding>

            <Label text="Nombre de Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Activa:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <CheckBox fx:id="chkActiva" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </top>

    <center>
        <TableView fx:id="tblCategorias" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="350" text="Nombre" />
                <TableColumn fx:id="colActiva" prefWidth="100" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="15" /></padding>
         <TextField fx:id="txtBusqueda" prefHeight="25.0" prefWidth="158.0" promptText="Busqueda" />
         <Button fx:id="btnBuscar" onAction="#buscar" prefHeight="25.0" prefWidth="71.0" text="Buscar" />
         <Separator orientation="VERTICAL" prefHeight="0.0" prefWidth="5.0" />
            <Button fx:id="btnGuardar" onAction="#guardar" style="-fx-font-weight: bold;" text="Guardar Registro" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
            <Button fx:id="btnCerrar" onAction="#cerrar" text="Cerrar Ventana" />
        </HBox>
    </bottom>
</BorderPane>
