<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.uam.fact_app.controller.MenuPrincipalController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Módulos">
                    <MenuItem fx:id="mnuProductos" onAction="#abrirProductos" text="Productos" />
                    <MenuItem fx:id="mnuCategorias" onAction="#abrirCategorias" text="Categorías" />
                    <MenuItem fx:id="mnuCargos" onAction="#abrirCargos" text="Cargos" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="mnuSalir" onAction="#salir" text="Salir" />
                </Menu>
            </MenuBar>

            <ToolBar prefHeight="110.0" prefWidth="900.0" style="-fx-padding: 10 25;">
                <HBox alignment="CENTER_LEFT" spacing="300.0">
                    <Button fx:id="btnProductos" onAction="#abrirProductos" style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="70.0" fitWidth="80.0" mouseTransparent="true" preserveRatio="true">
                                <Image url="@../icons/productos.png" />
                            </ImageView>
                        </graphic>
                        <tooltip><Tooltip style="-fx-font-size: 14px;" text="Gestión de Productos" /></tooltip>
                    </Button>

                    <Button fx:id="btnCategorias" onAction="#abrirCategorias" style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="65.0" fitWidth="80.0" mouseTransparent="true" preserveRatio="true">
                                <Image url="@../icons/categorias.png" />
                            </ImageView>
                        </graphic>
                        <tooltip><Tooltip style="-fx-font-size: 14px;" text="Gestión de Categorías" /></tooltip>
                    </Button>

                    <Button fx:id="btnCargos" onAction="#abrirCargos" style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="62.0" fitWidth="80.0" mouseTransparent="true" preserveRatio="true">
                                <Image url="@../icons/cargos.png" />
                            </ImageView>
                        </graphic>
                        <tooltip><Tooltip style="-fx-font-size: 14px;" text="Gestión de Cargos" /></tooltip>
                    </Button>
                </HBox>
            </ToolBar>
        </VBox>
    </top>

    <left>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets bottom="10.0" left="40.0" right="15.0" top="10.0" />
            </padding>

            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Resumen" />


            <VBox alignment="CENTER" prefHeight="95.0" prefWidth="180.0" spacing="4.0" style="-fx-background-color: #e3f2fd; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0;" text="Productos" />
                <Label fx:id="lblTotalProductos" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;" text="0" />
            </VBox>


            <VBox alignment="CENTER" prefHeight="95.0" prefWidth="180.0" spacing="4.0" style="-fx-background-color: #e8f5e9; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="Categorías" />
                <Label fx:id="lblTotalCategorias" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" text="0" />
            </VBox>


            <VBox alignment="CENTER" prefHeight="95.0" prefWidth="180.0" spacing="4.0" style="-fx-background-color: #fff3e0; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #ef6c00;" text="Cargos" />
                <Label fx:id="lblTotalCargos" style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #e65100;" text="0" />
            </VBox>
        </VBox>
    </left>


    <center>
        <VBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="40.0" top="10.0" />
            </padding>
            <ImageView fx:id="imgLogo" fitHeight="200.0" fitWidth="280.0" preserveRatio="true">
                <Image url="@../icons/logo.png" />
            </ImageView>
            <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Sistema de Facturación" />
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets bottom="15.0" right="25.0" />
            </padding>
            <Button fx:id="btnSalir" onAction="#salir" style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <ImageView fitHeight="45.0" fitWidth="50.0" mouseTransparent="true" preserveRatio="true">
                        <Image url="@../icons/salir.png" />
                    </ImageView>
                </graphic>
                <tooltip><Tooltip style="-fx-font-size: 13px;" text="Cerrar el Sistema" /></tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
