<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.uam.fact_app.controller.MenuPrincipalController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Módulos">
                    <MenuItem fx:id="mnuProductos" onAction="#abrirProductos" text="Productos" />
                    <MenuItem fx:id="mnuCategorias" onAction="#abrirCategorias" text="Categorías" />
                    <MenuItem fx:id="mnuCargos" onAction="#abrirCargos" text="Cargos" />
                    <SeparatorMenuItem />
                    <MenuItem fx:id="mnuSalir" onAction="#salir" text="Salir" />
                </Menu>
            </MenuBar>

            <ToolBar prefHeight="162.0" prefWidth="900.0" style="-fx-padding: 10;">
                <Button fx:id="btnProductos" onAction="#abrirProductos" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="79.0" fitWidth="100.0" preserveRatio="true">
                            <Image url="@../icons/productos.png" />
                        </ImageView>
                    </graphic>
                    <tooltip><Tooltip style="-fx-font-size: 14px;" text="Gestión de Productos" /></tooltip>
                </Button>

                <Button fx:id="btnCategorias" onAction="#abrirCategorias" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="70.0" fitWidth="100.0" preserveRatio="true">
                            <Image url="@../icons/categorias.png" />
                        </ImageView>
                    </graphic>
                    <tooltip><Tooltip style="-fx-font-size: 14px;" text="Gestión de Categorías" /></tooltip>
                </Button>

                <Button fx:id="btnCargos" onAction="#abrirCargos" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="67.0" fitWidth="100.0" preserveRatio="true">
                            <Image url="@../icons/cargos.png" />
                        </ImageView>
                    </graphic>
                    <tooltip><Tooltip style="-fx-font-size: 14px;" text="Gestión de Cargos" /></tooltip>
                </Button>

                <Pane HBox.hgrow="ALWAYS" />

                <!-- Botón de Salir con ícono -->
                <Button fx:id="btnSalir" onAction="#salir" style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitHeight="66.0" fitWidth="80.0" preserveRatio="true">
                            <Image url="@../icons/salir.png" /> <!-- Asegúrate de tener salir.png -->
                        </ImageView>
                    </graphic>
                    <tooltip><Tooltip style="-fx-font-size: 14px;" text="Cerrar el Sistema" /></tooltip>
                </Button>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="40.0">
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Resumen" />

            <HBox alignment="CENTER" spacing="30.0">
                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #e3f2fd; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1565c0;" text="Productos" />
                    <Label fx:id="lblTotalProductos" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;" text="0" />
                </VBox>

                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #e8f5e9; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="Categorías" />
                    <Label fx:id="lblTotalCategorias" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" text="0" />
                </VBox>

                <VBox alignment="CENTER" prefHeight="150.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #fff3e0; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #ef6c00;" text="Cargos" />
                    <Label fx:id="lblTotalCargos" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: #e65100;" text="0" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
