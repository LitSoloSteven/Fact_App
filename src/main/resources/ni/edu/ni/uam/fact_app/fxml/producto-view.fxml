<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.ni.uam.fact_app.controller.ProductoController">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>


    <top>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15"/></padding>


            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="cmbCategoria" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="txtExistencia" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label text="Activo:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <CheckBox fx:id="chkActivo" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="5"/>


            <VBox alignment="CENTER" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="6">
                <GridPane.margin><Insets left="40"/></GridPane.margin>

                <ImageView fx:id="imgProducto" fitHeight="150" fitWidth="150" preserveRatio="true" style="-fx-effect: innershadow(gaussian, gray, 5, 0, 0, 0);" />
                <Button fx:id="btnImagen" text="Seleccionar Imagen..." onAction="#seleccionarImagen"/>
            </VBox>
        </GridPane>
    </top>


    <center>
        <TableView fx:id="tblProductos" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="100"/>
                <TableColumn fx:id="colActivo" text="Estado" prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>


    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="15"/></padding>
            <Button fx:id="btnGuardar" text="Guardar Registro" onAction="#guardar" style="-fx-font-weight: bold;"/>
            <Button fx:id="btnCerrar" text="Cerrar Ventana" onAction="#cerrar"/>
        </HBox>
    </bottom>
</BorderPane>