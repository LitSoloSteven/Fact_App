<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.ni.uam.fact_app.controller.ProductoController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <top>
        <GridPane hgap="10" vgap="10">
            <padding><Insets bottom="15" /></padding>

            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbCategoria" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <TextField fx:id="txtExistencia" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Activo:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <CheckBox fx:id="chkActivo" text="Sí" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <VBox alignment="CENTER" spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="6">
                <GridPane.margin><Insets left="40" /></GridPane.margin>
                <StackPane prefHeight="150.0" prefWidth="150.0" style="-fx-border-color: #cccccc; -fx-border-style: dashed; -fx-border-width: 2; -fx-background-color: #fafafa; -fx-border-radius: 4;">
                    <Label style="-fx-text-fill: #999999;" text="Sin imagen" />
                    <ImageView fx:id="imgProducto" fitHeight="145" fitWidth="145" preserveRatio="true" />
                </StackPane>
                <Button fx:id="btnImagen" onAction="#seleccionarImagen" text="Seleccionar Imagen..." />
            </VBox>

            <columnConstraints>
                <ColumnConstraints />
                <ColumnConstraints />
                <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>
    </top>

    <center>
        <VBox spacing="10.0">
            <!-- BARRA DE FILTROS -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="Filtrar:" />
                <TextField fx:id="txtBusqueda" onAction="#buscar" prefWidth="220.0" promptText="Buscar por código o nombre" />
                <ComboBox fx:id="cmbFiltroCategoria" prefWidth="170.0" />
                <ComboBox fx:id="cmbFiltroEstado" prefWidth="110.0" />
                <Button fx:id="btnBusqueda" onAction="#buscar" text="Buscar" />
            </HBox>

            <TableView fx:id="tblProductos" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFoto" prefWidth="60" text="Foto" />
                    <TableColumn fx:id="colCodigo" prefWidth="90" text="Código" />
                    <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre" />
                    <TableColumn fx:id="colCategoria" prefWidth="110" text="Categoría" />
                    <TableColumn fx:id="colPrecio" prefWidth="90" text="Precio" />
                    <TableColumn fx:id="colExistencia" prefWidth="80" text="Existencia" />
                    <TableColumn fx:id="colActivo" prefWidth="80" text="Estado" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="15" /></padding>
            <Button fx:id="btnGuardar" onAction="#guardar" style="-fx-font-weight: bold;" text="Guardar Registro" />
            <Button fx:id="btnEliminar" onAction="#eliminar" prefHeight="25.0" prefWidth="89.0" text="Eliminar" />
            <Button fx:id="btnCerrar" onAction="#cerrar" text="Cerrar Ventana" />
        </HBox>
    </bottom>
</BorderPane>
